rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUser() {
      return signedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath()).data;
    }

    function activeUser() {
      return hasUser() && currentUser().active == true;
    }

    function isAdmin() {
      return activeUser() && currentUser().role == 'admin';
    }

    function isParticipant(data) {
      return activeUser()
        && ('participantUids' in data)
        && data.participantUids.hasAny([request.auth.uid]);
    }

    function applicationData(applicationId) {
      return get(/databases/$(database)/documents/applications/$(applicationId)).data;
    }

    function participantOf(applicationId) {
      return isParticipant(applicationData(applicationId));
    }

    // Bootstrap: cada usuário autenticado pode ler o próprio registro.
    // Somente o primeiro Admin (criado manualmente no Console) administra usuários.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /volunteer_profiles/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow read: if activeUser() && (isAdmin() || isParticipant(resource.data));
      allow create, update, delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if activeUser() && (isAdmin() || participantOf(resource.data.applicationId));
      allow create, update, delete: if isAdmin();
    }

    match /activity_sessions/{sessionId} {
      allow read: if activeUser() && (isAdmin() || participantOf(resource.data.applicationId));
      allow create, update, delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
