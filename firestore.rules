rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUser() {
      return signedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath()).data;
    }

    function activeUser() {
      return hasUser() && currentUser().active == true;
    }

    function isManager() {
      return activeUser() && currentUser().role in ['admin', 'coordinator'];
    }

    function isParticipant(data) {
      return activeUser()
        && ('participantUids' in data)
        && data.participantUids.hasAny([request.auth.uid]);
    }

    function applicationData(applicationId) {
      return get(/databases/$(database)/documents/applications/$(applicationId)).data;
    }

    function participantOf(applicationId) {
      return isParticipant(applicationData(applicationId));
    }

    function candidateEditable(applicationId) {
      let app = applicationData(applicationId);
      return app.active == true && app.status in ['pending', 'adjustments'];
    }

    function candidateWindowOpen(applicationId) {
      let app = applicationData(applicationId);
      return candidateEditable(applicationId)
        && ('planningDeadlineAt' in app)
        && app.planningDeadlineAt != null
        && request.time <= app.planningDeadlineAt;
    }

    function approvedApplication(applicationId) {
      let app = applicationData(applicationId);
      return app.active == true && app.status == 'approved';
    }

    function participantMarksFirstAccess(uid) {
      return signedIn()
        && request.auth.uid == uid
        && resource.data.role == 'volunteer'
        && (!('firstPortalAccessAt' in resource.data) || resource.data.firstPortalAccessAt == null)
        && request.resource.data.firstPortalAccessAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstPortalAccessAt', 'updatedAt'
        ]);
    }

    function participantMaySubmitApplication() {
      return isParticipant(resource.data)
        && resource.data.active == true
        && resource.data.status in ['pending', 'adjustments']
        && ('planningDeadlineAt' in resource.data)
        && resource.data.planningDeadlineAt != null
        && request.time <= resource.data.planningDeadlineAt
        && request.resource.data.status == 'analysis'
        && request.resource.data.active == resource.data.active
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.unitId == resource.data.unitId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'planningSubmittedAt',
          'updatedAt'
        ]);
    }

    function participantMayResetEmptyAdjustment() {
      return isParticipant(resource.data)
        && resource.data.active == true
        && resource.data.status == 'adjustments'
        && request.resource.data.status == 'pending'
        && request.resource.data.planningSubmittedAt == null
        && request.resource.data.dayAdjustments == {}
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'planningSubmittedAt',
          'dayAdjustments',
          'updatedAt'
        ]);
    }

    function createsApprovedProposal(data) {
      return activeUser()
        && participantOf(data.applicationId)
        && approvedApplication(data.applicationId)
        && data.postApprovalProposal == true
        && data.reviewStatus == 'analysis'
        && data.reviewNote == ''
        && data.reviewSubmittedAt == request.time
        && data.createdByUid == request.auth.uid;
    }

    function updatesApprovedProposal() {
      return activeUser()
        && participantOf(resource.data.applicationId)
        && approvedApplication(resource.data.applicationId)
        && resource.data.postApprovalProposal == true
        && resource.data.reviewStatus == 'adjustments'
        && request.resource.data.postApprovalProposal == true
        && request.resource.data.reviewStatus == 'analysis'
        && request.resource.data.reviewNote == ''
        && request.resource.data.reviewSubmittedAt == request.time
        && request.resource.data.createdByUid == resource.data.createdByUid;
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isManager();
      allow create, delete: if isManager();
      allow update: if isManager() || participantMarksFirstAccess(uid);
    }

    match /units/{unitId} {
      allow read: if activeUser();
      allow create, update, delete: if isManager();
    }

    match /volunteer_profiles/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || isManager());
      allow create, update, delete: if isManager();
    }

    match /applications/{applicationId} {
      allow read: if activeUser() && (isManager() || isParticipant(resource.data));
      allow create, delete: if isManager();
      allow update: if isManager() || participantMaySubmitApplication() || participantMayResetEmptyAdjustment();
    }

    match /activities/{activityId} {
      allow read: if activeUser() && (isManager() || participantOf(resource.data.applicationId));

      allow create: if isManager() || (
        activeUser()
        && participantOf(request.resource.data.applicationId)
        && (
          (
            candidateWindowOpen(request.resource.data.applicationId)
            && request.resource.data.createdByUid == request.auth.uid
          )
          || createsApprovedProposal(request.resource.data)
        )
      );

      allow update: if isManager() || (
        activeUser()
        && participantOf(resource.data.applicationId)
        && request.resource.data.applicationId == resource.data.applicationId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && (
          (
            candidateWindowOpen(resource.data.applicationId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'description', 'duration', 'participation', 'materials',
              'notes', 'period', 'time', 'ownerName', 'updatedAt'
            ])
          )
          ||
          (
            updatesApprovedProposal()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'description', 'duration', 'participation', 'materials',
              'notes', 'period', 'time', 'ownerName', 'postApprovalProposal',
              'reviewStatus', 'reviewNote', 'reviewSubmittedAt', 'updatedAt'
            ])
          )
        )
      );

      allow delete: if isManager() || (
        activeUser()
        && participantOf(resource.data.applicationId)
        && resource.data.createdByUid == request.auth.uid
        && (!('managerCreated' in resource.data) || resource.data.managerCreated != true)
        && (
          candidateEditable(resource.data.applicationId)
          || (
            approvedApplication(resource.data.applicationId)
            && resource.data.postApprovalProposal == true
            && resource.data.reviewStatus == 'adjustments'
          )
        )
      );
    }

    match /activity_sessions/{sessionId} {
      allow read: if activeUser() && (isManager() || participantOf(resource.data.applicationId));

      allow create: if isManager() || (
        activeUser()
        && participantOf(request.resource.data.applicationId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.unitId == applicationData(request.resource.data.applicationId).unitId
        && request.resource.data.status == 'proposed'
        && request.resource.data.groupId == null
        && (
          candidateWindowOpen(request.resource.data.applicationId)
          || createsApprovedProposal(request.resource.data)
        )
      );

      allow update: if isManager() || (
        activeUser()
        && participantOf(resource.data.applicationId)
        && request.resource.data.applicationId == resource.data.applicationId
        && request.resource.data.activityId == resource.data.activityId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.unitId == resource.data.unitId
        && request.resource.data.groupId == resource.data.groupId
        && (
          (
            candidateWindowOpen(resource.data.applicationId)
            && resource.data.status == 'proposed'
            && request.resource.data.status == 'proposed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'activityName', 'activityDescription', 'participation', 'materials',
              'notes', 'ownerName', 'date', 'time', 'period', 'duration', 'updatedAt'
            ])
          )
          ||
          (
            approvedApplication(resource.data.applicationId)
            && resource.data.status == 'confirmed'
            && request.resource.data.status == 'change_requested'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'date', 'time', 'status', 'changeNote', 'changeRequestedAt', 'updatedAt'
            ])
          )
          ||
          (
            updatesApprovedProposal()
            && resource.data.status == 'proposed'
            && request.resource.data.status == 'proposed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'activityName', 'activityDescription', 'participation', 'materials',
              'notes', 'ownerName', 'date', 'time', 'period', 'duration', 'status',
              'postApprovalProposal', 'reviewStatus', 'reviewNote',
              'reviewSubmittedAt', 'updatedAt'
            ])
          )
        )
      );

      allow delete: if isManager() || (
        activeUser()
        && participantOf(resource.data.applicationId)
        && resource.data.createdByUid == request.auth.uid
        && (!('managerCreated' in resource.data) || resource.data.managerCreated != true)
        && (
          (
            candidateEditable(resource.data.applicationId)
            && resource.data.status == 'proposed'
          )
          ||
          (
            approvedApplication(resource.data.applicationId)
            && resource.data.status == 'proposed'
            && resource.data.postApprovalProposal == true
            && resource.data.reviewStatus == 'adjustments'
          )
        )
      );
    }

    match /groups/{groupId} {
      allow read, create, update, delete: if isManager();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
