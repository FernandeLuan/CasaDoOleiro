rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUser() {
      return signedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath()).data;
    }

    function activeUser() {
      return hasUser() && currentUser().active == true;
    }

    function isAdmin() {
      return activeUser() && currentUser().role == 'admin';
    }

    function isCoordinator() {
      return activeUser() && currentUser().role == 'coordinator';
    }

    function isActivityAssistant() {
      return activeUser() && currentUser().role == 'activity_assistant';
    }

    function isManager() {
      return isAdmin() || isCoordinator();
    }

    function managerHasUnit(unitId) {
      return isAdmin() || (
        isCoordinator()
        && ('unitIds' in currentUser())
        && currentUser().unitIds.hasAny([unitId])
      );
    }

    function assistantHasUnit(unitId) {
      return isActivityAssistant()
        && ('unitIds' in currentUser())
        && currentUser().unitIds.hasAny([unitId]);
    }

    function isParticipant(data) {
      return activeUser()
        && ('participantUids' in data)
        && data.participantUids.hasAny([request.auth.uid]);
    }

    function applicationData(applicationId) {
      return get(/databases/$(database)/documents/applications/$(applicationId)).data;
    }

    function participantOf(applicationId) {
      return isParticipant(applicationData(applicationId));
    }

    function managerOfApplication(applicationId) {
      let app = applicationData(applicationId);
      return managerHasUnit(app.unitId);
    }

    function assistantOfApplication(applicationId) {
      let app = applicationData(applicationId);
      return assistantHasUnit(app.unitId);
    }

    function candidateEditable(applicationId) {
      let app = applicationData(applicationId);
      return app.active == true && app.status in ['pending', 'analysis', 'adjustments'];
    }

    function candidateWindowOpen(applicationId) {
      let app = applicationData(applicationId);
      return candidateEditable(applicationId)
        && (
          app.status == 'analysis'
          || (
            ('planningDeadlineAt' in app)
            && app.planningDeadlineAt != null
            && request.time <= app.planningDeadlineAt
          )
        );
    }

    function approvedApplication(applicationId) {
      let app = applicationData(applicationId);
      return app.active == true && app.status == 'approved';
    }

    function proposalApplication(applicationId) {
      let app = applicationData(applicationId);
      return app.active == true && app.status in ['meeting', 'approved'];
    }

    /* Legacy production records may predate createdByUid. They remain editable only
       during the candidate planning window and never when explicitly manager-created. */
    function participantOwnsEditableLegacy(data) {
      let app = applicationData(data.applicationId);
      return (!('managerCreated' in data) || data.managerCreated != true)
        && (
          !('createdByUid' in data)
          || data.createdByUid == request.auth.uid
          || (('participantUids' in app) && app.participantUids.hasAny([data.createdByUid]))
        );
    }

    function participantHistoryTypeAllowed(type) {
      return type in [
        'planning_submitted', 'planning_resent',
        'activity_created', 'activity_updated', 'activity_deleted',
        'session_moved'
      ];
    }

    function participantMarksFirstAccess(uid) {
      return signedIn()
        && request.auth.uid == uid
        && resource.data.role == 'volunteer'
        && (!('firstPortalAccessAt' in resource.data) || resource.data.firstPortalAccessAt == null)
        && request.resource.data.firstPortalAccessAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstPortalAccessAt', 'updatedAt'
        ]);
    }

    function participantUpdatesEmergencyContact(uid) {
      return activeUser()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'emergencyContact', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.emergencyContact is map
        && request.resource.data.emergencyContact.keys().hasAll([
          'name', 'relationship', 'phone'
        ])
        && request.resource.data.emergencyContact.keys().hasOnly([
          'name', 'relationship', 'phone'
        ])
        && request.resource.data.emergencyContact.name is string
        && request.resource.data.emergencyContact.relationship is string
        && request.resource.data.emergencyContact.phone is string
        && request.resource.data.emergencyContact.name.size() <= 120
        && request.resource.data.emergencyContact.relationship.size() <= 80
        && request.resource.data.emergencyContact.phone.size() <= 40
        && (
          (
            request.resource.data.emergencyContact.name == ''
            && request.resource.data.emergencyContact.relationship == ''
            && request.resource.data.emergencyContact.phone == ''
          )
          || (
            request.resource.data.emergencyContact.name.size() > 0
            && request.resource.data.emergencyContact.phone.size() > 0
          )
        );
    }

    function participantMaySubmitApplication() {
      return isParticipant(resource.data)
        && resource.data.active == true
        && resource.data.status in ['pending', 'analysis', 'adjustments']
        && (
          resource.data.status == 'analysis'
          || (
            ('planningDeadlineAt' in resource.data)
            && resource.data.planningDeadlineAt != null
            && request.time <= resource.data.planningDeadlineAt
          )
        )
        && request.resource.data.status == 'analysis'
        && request.resource.data.active == resource.data.active
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.unitId == resource.data.unitId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'planningSubmittedAt',
          'updatedAt'
        ]);
    }

    function participantMayResetEmptyAdjustment() {
      return isParticipant(resource.data)
        && resource.data.active == true
        && resource.data.status == 'adjustments'
        && request.resource.data.status == 'pending'
        && request.resource.data.planningSubmittedAt == null
        && request.resource.data.dayAdjustments == {}
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'planningSubmittedAt',
          'dayAdjustments',
          'updatedAt'
        ]);
    }

    function assistantMayManageApplication() {
      return assistantHasUnit(resource.data.unitId)
        && request.resource.data.unitId == resource.data.unitId
        && request.resource.data.participantUids == resource.data.participantUids;
    }

    function assistantMayManageVolunteerUser() {
      return isActivityAssistant()
        && resource.data.role == 'volunteer'
        && request.resource.data.role == 'volunteer'
        && ('unitIds' in resource.data)
        && ('unitIds' in currentUser())
        && resource.data.unitIds.hasAny(currentUser().unitIds)
        && request.resource.data.unitIds == resource.data.unitIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active', 'updatedAt'
        ]);
    }

    function assistantMayRequestApplicationAdjustment() {
      return assistantHasUnit(resource.data.unitId)
        && request.resource.data.unitId == resource.data.unitId
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.status == 'adjustments'
        && request.resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'active', 'planningDeadlineAt', 'updatedAt'
        ]);
    }

    function createsApprovedProposal(data) {
      return activeUser()
        && participantOf(data.applicationId)
        && proposalApplication(data.applicationId)
        && data.postApprovalProposal == true
        && data.reviewStatus == 'analysis'
        && data.reviewNote == ''
        && data.reviewSubmittedAt == request.time
        && data.createdByUid == request.auth.uid;
    }

    function updatesApprovedProposal() {
      return activeUser()
        && participantOf(resource.data.applicationId)
        && proposalApplication(resource.data.applicationId)
        && resource.data.postApprovalProposal == true
        && resource.data.reviewStatus == 'adjustments'
        && request.resource.data.postApprovalProposal == true
        && request.resource.data.reviewStatus == 'analysis'
        && request.resource.data.reviewNote == ''
        && request.resource.data.reviewSubmittedAt == request.time
        && request.resource.data.createdByUid == resource.data.createdByUid;
    }

    function participantSubmitsSessionAdjustment() {
      return activeUser()
        && participantOf(resource.data.applicationId)
        && candidateEditable(resource.data.applicationId)
        && request.resource.data.status == resource.data.status
        && ('adminAdjustmentStatus' in resource.data)
        && resource.data.adminAdjustmentStatus == 'requested'
        && request.resource.data.adminAdjustmentStatus == 'analysis'
        && request.resource.data.adminAdjustmentSubmittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'adminAdjustmentStatus', 'adminAdjustmentSubmittedAt', 'updatedAt'
        ]);
    }

    function participantRequestsApprovedChange() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return activeUser()
        && participantOf(resource.data.applicationId)
        && approvedApplication(resource.data.applicationId)
        /* Admin-created sessions use manager_confirmed; volunteer-created confirmed sessions
           use confirmed. Both must support a proposal without mutating the accepted values. */
        && resource.data.status in ['confirmed', 'manager_confirmed']
        && request.resource.data.status == 'change_requested'
        && request.resource.data.changeProposal is map
        && request.resource.data.changeReviewStatus == 'analysis'
        && request.resource.data.changeReviewNote == ''
        && request.resource.data.changeRequestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && changed.hasOnly([
          'status', 'changeProposal', 'changeNote', 'changeRequestedAt',
          'changeReviewStatus', 'changeReviewNote', 'adminAdjustmentStatus', 'updatedAt'
        ])
        && (
          !changed.hasAny(['adminAdjustmentStatus'])
          || (
            ('adminAdjustmentStatus' in resource.data)
            && resource.data.adminAdjustmentStatus == 'requested'
            && request.resource.data.adminAdjustmentStatus == 'analysis'
          )
        );
    }

    function participantResubmitsApprovedChange() {
      return activeUser()
        && participantOf(resource.data.applicationId)
        && approvedApplication(resource.data.applicationId)
        && resource.data.status == 'change_requested'
        && resource.data.changeReviewStatus == 'adjustments'
        && request.resource.data.status == 'change_requested'
        && request.resource.data.changeProposal is map
        && request.resource.data.changeReviewStatus == 'analysis'
        && request.resource.data.changeReviewNote == ''
        && request.resource.data.changeRequestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'changeProposal', 'changeNote', 'changeRequestedAt',
          'changeReviewStatus', 'changeReviewNote', 'updatedAt'
        ]);
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isManager() || (isActivityAssistant() && ('unitIds' in resource.data) && resource.data.unitIds.hasAny(currentUser().unitIds));
      allow create, delete: if isManager();
      allow update: if isManager() || assistantMayManageVolunteerUser() || participantMarksFirstAccess(uid);
    }

    match /units/{unitId} {
      allow read: if activeUser();
      allow create, update, delete: if isManager();
    }

    match /volunteer_profiles/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || isManager());
      allow create, delete: if isManager();
      allow update: if isManager() || participantUpdatesEmergencyContact(uid);
    }

    match /applications/{applicationId} {
      allow read: if activeUser() && (
        isManager()
        || assistantHasUnit(resource.data.unitId)
        || isParticipant(resource.data)
      );
      allow create, delete: if isManager();
      allow update: if isManager()
        || assistantMayManageApplication()
        || assistantMayRequestApplicationAdjustment()
        || participantMaySubmitApplication()
        || participantMayResetEmptyAdjustment();

      match /history/{eventId} {
        allow read: if activeUser() && (managerOfApplication(applicationId) || assistantOfApplication(applicationId));
        allow create: if activeUser()
          && request.resource.data.applicationId == applicationId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.unitId == applicationData(applicationId).unitId
          && (
            managerOfApplication(applicationId)
            || assistantOfApplication(applicationId)
            || (
              participantOf(applicationId)
              && participantHistoryTypeAllowed(request.resource.data.type)
            )
          );
        allow update, delete: if false;
      }
    }

    match /activities/{activityId} {
      allow read: if activeUser() && (
        isManager()
        || assistantOfApplication(resource.data.applicationId)
        || participantOf(resource.data.applicationId)
      );

      allow create: if isManager()
        || (
          isActivityAssistant()
          && assistantHasUnit(applicationData(request.resource.data.applicationId).unitId)
        )
        || (
          activeUser()
          && participantOf(request.resource.data.applicationId)
          && (
            (
              candidateWindowOpen(request.resource.data.applicationId)
              && request.resource.data.createdByUid == request.auth.uid
            )
            || createsApprovedProposal(request.resource.data)
          )
        );

      allow update: if isManager()
        || (
          assistantOfApplication(resource.data.applicationId)
          && request.resource.data.applicationId == resource.data.applicationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'duration', 'participation', 'materials',
            'notes', 'period', 'time', 'ownerName',
            'reviewStatus', 'reviewNote', 'reviewSubmittedAt', 'reviewRequestNote',
            'reviewBaseline', 'updatedAt'
          ])
        )
        || (
          activeUser()
          && participantOf(resource.data.applicationId)
          && request.resource.data.applicationId == resource.data.applicationId
          && (
            (
              candidateWindowOpen(resource.data.applicationId)
              && participantOwnsEditableLegacy(resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'name', 'description', 'duration', 'participation', 'materials',
                'notes', 'period', 'time', 'ownerName', 'updatedAt'
              ])
            )
            ||
            (
              updatesApprovedProposal()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'name', 'description', 'duration', 'participation', 'materials',
                'notes', 'period', 'time', 'ownerName', 'postApprovalProposal',
                'reviewStatus', 'reviewNote', 'reviewSubmittedAt', 'updatedAt'
              ])
            )
          )
        );

      allow delete: if isManager()
        || assistantOfApplication(resource.data.applicationId)
        || (
          activeUser()
          && participantOf(resource.data.applicationId)
          && participantOwnsEditableLegacy(resource.data)
          && (
            candidateEditable(resource.data.applicationId)
            || (
              proposalApplication(resource.data.applicationId)
              && resource.data.postApprovalProposal == true
              && resource.data.reviewStatus == 'adjustments'
            )
          )
        );
    }

    match /activity_sessions/{sessionId} {
      allow read: if activeUser() && (
        isManager()
        || assistantOfApplication(resource.data.applicationId)
        || participantOf(resource.data.applicationId)
      );

      allow create: if isManager()
        || (
          isActivityAssistant()
          && assistantOfApplication(request.resource.data.applicationId)
          && request.resource.data.unitId == applicationData(request.resource.data.applicationId).unitId
        )
        || (
          activeUser()
          && participantOf(request.resource.data.applicationId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.unitId == applicationData(request.resource.data.applicationId).unitId
          && request.resource.data.status == 'proposed'
          && request.resource.data.groupId == null
          && (
            candidateWindowOpen(request.resource.data.applicationId)
            || createsApprovedProposal(request.resource.data)
          )
        );

      allow update: if isManager()
        || (
          assistantOfApplication(resource.data.applicationId)
          && request.resource.data.applicationId == resource.data.applicationId
          && request.resource.data.activityId == resource.data.activityId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'activityName', 'activityDescription', 'participation', 'materials',
            'notes', 'ownerName', 'date', 'time', 'period', 'duration', 'groupId',
            'status', 'changeNote', 'changeRequestedAt', 'changeProposal',
            'changeReviewStatus', 'changeReviewNote', 'changeReviewedAt',
            'changeReviewRequestNote', 'changeReviewBaseline',
            'adminAdjustmentStatus', 'adminAdjustmentNote',
            'adminAdjustmentRequestedAt', 'adminAdjustmentSubmittedAt',
            'adminAdjustmentBaseline', 'reviewStatus', 'reviewNote',
            'reviewSubmittedAt', 'reviewRequestNote', 'reviewBaseline', 'updatedAt'
          ])
        )
        || (
          activeUser()
          && participantOf(resource.data.applicationId)
          && request.resource.data.applicationId == resource.data.applicationId
          && request.resource.data.activityId == resource.data.activityId
          && (
            (
              (
                (
                  candidateWindowOpen(resource.data.applicationId)
                  && resource.data.status == 'proposed'
                  && request.resource.data.status == 'proposed'
                  && participantOwnsEditableLegacy(resource.data)
                )
                || (
                  candidateEditable(resource.data.applicationId)
                  && ('adminAdjustmentStatus' in resource.data)
                  && resource.data.adminAdjustmentStatus == 'requested'
                  && request.resource.data.adminAdjustmentStatus == 'requested'
                  && request.resource.data.status == resource.data.status
                )
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'activityName', 'activityDescription', 'participation', 'materials',
                'notes', 'ownerName', 'date', 'time', 'period', 'duration', 'updatedAt'
              ])
            )
            || participantSubmitsSessionAdjustment()
            || participantRequestsApprovedChange()
            || participantResubmitsApprovedChange()
            || (
              updatesApprovedProposal()
              && resource.data.status == 'proposed'
              && request.resource.data.status == 'proposed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'activityName', 'activityDescription', 'participation', 'materials',
                'notes', 'ownerName', 'date', 'time', 'period', 'duration', 'status',
                'postApprovalProposal', 'reviewStatus', 'reviewNote',
                'reviewSubmittedAt', 'updatedAt'
              ])
            )
          )
        );

      allow delete: if isManager()
        || assistantOfApplication(resource.data.applicationId)
        || (
          activeUser()
          && participantOf(resource.data.applicationId)
          && participantOwnsEditableLegacy(resource.data)
          && (
            (
              candidateEditable(resource.data.applicationId)
              && resource.data.status == 'proposed'
            )
            || (
              proposalApplication(resource.data.applicationId)
              && resource.data.status == 'proposed'
              && resource.data.postApprovalProposal == true
              && resource.data.reviewStatus == 'adjustments'
            )
          )
        );
    }

    match /groups/{groupId} {
      allow read: if isManager() || (
        isActivityAssistant() && assistantHasUnit(resource.data.unitId)
      );
      allow create: if isManager() || (
        isActivityAssistant() && assistantHasUnit(request.resource.data.unitId)
      );
      allow update, delete: if isManager() || (
        isActivityAssistant()
        && assistantHasUnit(resource.data.unitId)
        && request.resource.data.unitId == resource.data.unitId
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
