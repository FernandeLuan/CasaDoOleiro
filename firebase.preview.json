{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.preview.json",
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "tests/**",
      "test-results/**",
      "playwright-report/**",
      "coverage/**",
      "docs/**",
      "tools/**",
      "*.md",
      "package.json",
      "package-lock.json",
      "playwright.config.js",
      "firebase-debug.log*"
    ],
    "rewrites": [
      {"source": "/", "destination": "/homologacao/index.html"}
    ],
    "headers": [
      {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
      {"source": "**/*.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "**/*.css", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  }
}
