{
  "name": "casa-do-oleiro-web",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:seed": "node tests/e2e/seed.mjs",
    "test:firestore:rules": "node --test tests/emulator/firestore-unit-isolation.test.mjs",
    "test:e2e:emulated": "firebase emulators:exec --only auth,firestore --project demo-casadooleiro \"npm run test:firestore:rules && npm run test:e2e:seed && npm run test:e2e\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.55.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^14.14.0"
  }
}
